@{
    ViewData["Title"] = "Quality management portal";
}

<section class="py-5">
    <h1>Quality management portal</h1>
    <p class="lead">Controlled documents and role-based training for your quality system.</p>
    <p>This release supports the document register, revision review and approval, effective-document access, and training acknowledgments.</p>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="ControlledDocuments" asp-action="Index">Open document register</a>
        <a class="btn btn-outline-primary" asp-controller="TrainingMatrix" asp-action="Index">Open training matrix</a>
    </div>
</section>
