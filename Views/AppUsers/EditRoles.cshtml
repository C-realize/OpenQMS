@model OpenQMS.Models.ViewModels.EditUserRolesInput

@{
    ViewData["Title"] = "Edit user roles";
}

<h1>Edit roles</h1>
<p>@Model.Email</p>
<form asp-action="EditRoles" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <fieldset class="mb-3">
        @foreach (var role in Model.AvailableRoles)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                       checked="@(Model.SelectedRoles.Contains(role))" id="role-@Model.AvailableRoles.IndexOf(role)" />
                <label class="form-check-label" for="role-@Model.AvailableRoles.IndexOf(role)">@role</label>
            </div>
        }
    </fieldset>
    <button class="btn btn-primary" type="submit">Save roles</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
