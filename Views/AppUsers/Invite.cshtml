@model OpenQMS.Models.ViewModels.InviteUserInput

@{
    ViewData["Title"] = "Invite user";
}

<h1>Invite user</h1>
<p>New accounts have no password. They must confirm their individual email address before using one-time email sign-in.</p>
<form asp-action="Invite" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <fieldset class="mb-3">
        <legend class="col-form-label">Starter role</legend>
        <p>Role assignments and document grants require local review before go-live.</p>
        @foreach (var role in Model.AvailableRoles)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                       checked="@(Model.SelectedRoles.Contains(role))" id="role-@Model.AvailableRoles.IndexOf(role)" />
                <label class="form-check-label" for="role-@Model.AvailableRoles.IndexOf(role)">@role</label>
            </div>
        }
    </fieldset>
    <button class="btn btn-primary" type="submit">Create account and send invitation</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
