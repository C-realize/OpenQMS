@using OpenQMS.Models.ViewModels
@model IEnumerable<UserRolesViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>User access</h1>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info" role="status">@statusMessage</div>
}

<h4>Users</h4>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Email
            </th>
            <th>
                Roles
            </th>
            <th>Email confirmed</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Roles)
            </td>
            <td>@(item.EmailConfirmed ? "Yes" : "No")</td>
            <td>
                <a asp-action="EditRoles" asp-route-id="@item.UserId">Edit roles</a>
                @if (User.IsInRole(Constants.AdministratorsRole) && !item.EmailConfirmed)
                {
                    <form asp-action="ResendInvitation" asp-route-id="@item.UserId" method="post" class="d-inline">
                        <button class="btn btn-link btn-sm" type="submit">Resend invitation</button>
                    </form>
                }
            </td>
        </tr>
        }
    </tbody>
</table>

@if(User.IsInRole(Constants.AdministratorsRole))
{
    <p>
        <a asp-action="Invite">Invite user</a>
    </p>
}