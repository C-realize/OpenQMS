@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<br />
<br />
<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-5">
        <h2>Sign in with your work email address.</h2>
        <hr />
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-info" role="status">@Model.StatusMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.SignInToken))
        {
            <p>Confirm that you opened your sign-in link on this device. The link can be used once.</p>
            <form method="post" asp-page-handler="Verify">
                <input type="hidden" name="email" value="@Model.SignInEmail" />
                <input type="hidden" name="token" value="@Model.SignInToken" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="w-100 btn btn-lg btn-primary">Continue to sign in</button>
            </form>
        }
        else
        {
            <form method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary mt-3">Email me a sign-in link</button>
                <p class="mt-3">The link expires after 15 minutes and works once. Contact your administrator if you cannot sign in.</p>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
